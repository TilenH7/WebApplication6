@page
@model WebApplication6.Pages.Trener.ProfilModel

<h2>Profil trenerja: @Model.Trener?.Ime (@Model.Trener?.Username)</h2>

@if (Model.Trener == null)
{
    <p>Trener ni bil najden.</p>
}
else
{
    <h3>Osnovni podatki</h3>
    <p><strong>Lokacija:</strong> @Model.Trener.Lokacija</p>
    <p><strong>Specializacije:</strong> @Model.Trener.Specializacije</p>
    <p><strong>Opis:</strong> @Model.Trener.Opis</p>

    <h3>Ocene</h3>
    @if (Model.PovprecnaOcena.HasValue)
    {
        <p><strong>Povprečna ocena:</strong> @Model.PovprecnaOcena.Value.ToString("0.0") / 5</p>

        <h4>Zadnji komentarji</h4>
        <ul>
            @foreach (var o in Model.ZadnjeOcene)
            {
                <li>
                    ⭐ @o.Ocena/5 – @o.Komentar (od @o.UporabnikUsername)
                </li>
            }
        </ul>
    }
    else
    {
        <p>Ta trener še nima ocen.</p>
    }

    <h3>Prihajajoči termini</h3>
    @if (!Model.PrihajajociTermini.Any())
    {
        <p>Trener trenutno nima prihajajočih terminov.</p>
    }
    else
    {
        <table border="1" cellpadding="5">
            <thead>
                <tr>
                    <th>Datum in ura</th>
                    <th>Lokacija</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.PrihajajociTermini)
                {
                    <tr>
                        <td>@t.DatumInCas.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@t.Lokacija</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
