@page
@model WebApplication6.Pages.Uporabnik.IndexModel

<h2>Uporabnik – dashboard</h2>
<p>Pozdravljen, @Model.Username!</p>

<h3>Iskanje terminov</h3>

<form method="get">
    <label>Lokacija</label>
    <input asp-for="SearchLokacija" />

    <label>Datum</label>
    <input asp-for="SearchDatum" type="date" />

    <button type="submit">Išči</button>
</form>

<hr />

<!-- ===== Razpoložljivi termini ===== -->
<h3>Razpoložljivi termini vadb</h3>

@if (!Model.Termini.Any())
{
    <p>Ni razpoložljivih terminov.</p>
}
else
{
    <table border="1" cellpadding="5">
        <thead>
            <tr>
                <th>Datum in ura</th>
                <th>Lokacija</th>
                <th>Trener</th>
                <th>Akcija</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Termini)
            {
                <tr>
                    <td>@t.DatumInCas.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@t.Lokacija</td>
                    <td>@t.TrenerUsername</td>
                    <td>
                        <a asp-page="/Uporabnik/Rezerviraj" asp-route-terminId="@t.Id">
                            Rezerviraj
                        </a>
                        |
                        <a asp-page="/Trener/Profil" asp-route-trener="@t.TrenerUsername">
                            Profil trenerja
                        </a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
}

<br />

<!-- ===== Moje rezervacije ===== -->
<h3>Moje rezervacije</h3>

@if (!Model.MojeRezervacije.Any())
{
        <p>Še nimaš rezerviranih terminov.</p>
}
else
{
        <table border="1" cellpadding="5">
        <thead>
            <tr>
                <th>Datum in ura</th>
                <th>Lokacija</th>
                <th>Trener</th>
                <th>Cena</th>
                <th>Akcija</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Termini)
            {
                <tr>
                    <td>@t.DatumInCas.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@t.Lokacija</td>
                    <td>@t.TrenerUsername</td>
                    <td>@t.Cena.ToString("0.00") €</td>
                    <td>
                        <a asp-page="/Uporabnik/Rezerviraj" asp-route-terminId="@t.Id">
                            Rezerviraj
                        </a>
                        |
                        <a asp-page="/Trener/Profil" asp-route-trener="@t.TrenerUsername">
                            Profil trenerja
                        </a>
                    </td>
                </tr>
            }
        </tbody>

        </table>
}
